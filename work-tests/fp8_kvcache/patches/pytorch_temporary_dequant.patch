+void dlc_dequant_e4m3(
+    const Tensor& input,
+    const Tensor& scale,
+    Tensor& output,
+    int64_t group_size) {
+  constexpr auto op = "dlc_dequant_e4m3";
+  TORCH_CHECK(group_size == 128, op, " only supports group_size=128");
+  TORCH_CHECK(input.defined() && scale.defined() && output.defined(),
+              op, " expects defined input, scale and output tensors");
+  TORCH_CHECK(input.is_dlc() && scale.is_dlc() && output.is_dlc(),
+              op, " expects DLC tensors");
+  TORCH_CHECK(input.device() == scale.device() && input.device() == output.device(),
+              op, " expects input, scale and output on the same device");
+  TORCH_CHECK(input.scalar_type() == at::ScalarType::Float8_e4m3fn,
+              op, " expects float8_e4m3fn input");
+  TORCH_CHECK(scale.scalar_type() == at::kByte, op, " expects uint8 scale codes");
+  TORCH_CHECK(output.scalar_type() == at::kBFloat16, op, " expects bfloat16 output");
+  TORCH_CHECK(input.dim() == 2 && scale.dim() == 2 && output.dim() == 2,
+              op, " expects 2D input, scale and output tensors");
+  TORCH_CHECK(input.sizes() == output.sizes(), op, " input and output shapes must match");
+
+  const int64_t num_tokens = input.size(0);
+  const int64_t hidden_size = input.size(1);
+  const int64_t num_groups = hidden_size / 128 + (hidden_size % 128 != 0);
+  TORCH_CHECK(scale.size(0) == num_tokens && scale.size(1) == num_groups,
+              op, " expects scale shape [T, ceil(D / 128)]");
+  TORCH_CHECK(input.is_contiguous() && scale.is_contiguous() && output.is_contiguous(),
+              op, " expects contiguous tensors");
+  TORCH_CHECK(input.storage_offset() == 0 && scale.storage_offset() == 0 &&
+                  output.storage_offset() == 0,
+              op, " expects tensors with storage_offset=0");
+  if (input.numel() == 0) {
+    return;
+  }
+
+  // The kernel ignores strides/offsets and DMA includes each row's padding.
+  TORCH_CHECK(!output.is_alias_of(input) && !output.is_alias_of(scale),
+              op, " output must not share storage with input or scale");
+  constexpr int64_t kernel_int_max = std::numeric_limits<int>::max();
+  TORCH_CHECK(hidden_size <= kernel_int_max - 511 && num_tokens <= kernel_int_max - 127,
+              op, " tensor dimensions exceed the kernel int32 limit");
+  const int64_t fp8_words = ((hidden_size + 511) / 512) * 128;
+  const int64_t bf16_words = ((hidden_size + 255) / 256) * 128;
+  const int64_t scale_words = ((num_groups + 511) / 512) * 128;
+  const int64_t max_row_words = std::max({fp8_words, bf16_words, scale_words});
+  TORCH_CHECK(num_tokens <= kernel_int_max / max_row_words,
+              op, " padded tensor offsets exceed the kernel int32 limit");
+
+  // Match the existing dequant kernel's per-row VMEM allocation.
+  const int64_t hidden_f32_stride = ((hidden_size + 127) / 128) * 128;
+  const int64_t scale_f32_stride = ((num_groups + 127) / 128) * 128;
+  const int64_t row_scratch_words = std::max(fp8_words, bf16_words) +
+      hidden_f32_stride + scale_words + scale_f32_stride;
+  TORCH_CHECK(row_scratch_words <= 3072 * 1024 - 256,
+              op, " a row exceeds the dequant kernel VMEM capacity");
+
+  auto k = at::dlc::KernelDesc();
+  k.input(input);
+  k.input(scale);
+  k.output(output);
+  k.scalar(static_cast<int>(group_size));
+  k.launch("custom_dequant_e4m3_g128_bf16");
+}
+
+}  // namespace at::native
